{
  "name": "select-paragraph",
  "displayName": "Select Paragraph",
  "description": "Select contiguous lines until you reach an empty line",
  "version": "0.1.2",
  "publisher": "nachocab",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:select-paragraph.selectParagraph"
  ],
  "main": "./extension",
  "contributes": {
    "commands": [
      {
        "command": "select-paragraph.selectParagraph",
        "title": "Select Paragraph"
      }
    ],
    "keybindings": [
      {
        "command": "select-paragraph.selectParagraph",
        "key": "ctrl+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "postinstall": "node ./node_modules/vscode/bin/install",
    "test": "node ./node_modules/vscode/bin/test"
  },
  "devDependencies": {
    "@types/mocha": "^2.2.42",
    "@types/node": "^8.0.26",
    "@types/vscode": "^1.74.0",
    "eslint": "^8.31.0",
    "mocha": "^10.2.0",
    "typescript": "^2.5.2",
    "vscode-test": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nachocab/vscode-select-paragraph"
  }
}
